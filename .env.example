# pii-service Environment Variables
# Copy to .env and fill in values before running locally.
# NEVER commit .env to source control.

# ---------------------------------------------------------------------------
# Core PII Detection
# ---------------------------------------------------------------------------

# Minimum Presidio confidence score (0.0-1.0).
# 0.5 balances precision vs recall for most education data.
# Raise to 0.7-0.8 to reduce false positives on ambiguous numeric patterns.
# Lower to 0.3-0.4 to catch more (and accept more false positives).
PII_SCORE_THRESHOLD=0.5

# Include spaCy NLP for PERSON/LOCATION detection.
# true  = full accuracy on names, ~30s startup, requires en_core_web_lg
# false = regex-only mode, instant startup, misses unlabeled names
PII_USE_SPACY=true

# ---------------------------------------------------------------------------
# Flask / Service
# ---------------------------------------------------------------------------

PORT=5900
FLASK_ENV=development

# ---------------------------------------------------------------------------
# API Key Authentication
# ---------------------------------------------------------------------------

# Leave empty to disable auth (local development only).
# Set a strong random value for production. All callers must send:
#   Authorization: Bearer <key>   OR   X-API-Key: <key>
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ---------------------------------------------------------------------------
# Batch and File Processing Limits
# ---------------------------------------------------------------------------

# Maximum number of texts in a /api/v1/sanitize/batch request
BATCH_SIZE_LIMIT=500

# Maximum rows in an uploaded CSV or JSON file
FILE_ROW_LIMIT=10000

# Maximum file upload size in megabytes
FILE_SIZE_LIMIT_MB=10

# Maximum characters in a single text input (scan, sanitize, preflight, process).
# Prevents runaway CPU/memory on malicious oversized payloads.
# Default 100000 (~100KB). Set higher for document-processing workflows.
MAX_TEXT_LENGTH=100000

# ---------------------------------------------------------------------------
# Dynamic Configuration (optional)
# ---------------------------------------------------------------------------

# Path to a JSON config file for per-entity thresholds, custom patterns,
# and institution-specific schema profiles.
# See docs/config-reference.md for format.
# Leave empty to use all defaults.
PII_CONFIG_FILE=

# ---------------------------------------------------------------------------
# Pseudonymization Security (optional)
# ---------------------------------------------------------------------------

# When set, pseudonymization uses HMAC-SHA256 seeded with this secret instead of MD5.
# This prevents an attacker from reversing pseudonyms by enumerating common values
# (e.g., trying all common SSN formats against the pseudonymized output).
# If empty or unset, MD5 is used (deterministic but reversible by enumeration).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: Changing this value changes ALL pseudonymized output — update downstream systems.
PSEUDO_SECRET=

# ---------------------------------------------------------------------------
# Sandbox Mode (optional)
# ---------------------------------------------------------------------------

# When true, all PII processing endpoints return deterministic fake responses
# without loading Presidio or spaCy. Use for integration testing, CI pipelines,
# and frontend development where the ML stack should not be exercised.
# WARNING: No real PII scanning happens in sandbox mode. Never use in production.
PII_SANDBOX_MODE=false

# ---------------------------------------------------------------------------
# Encoded Payload Decoding (optional)
# ---------------------------------------------------------------------------

# When true, text inputs are decoded before scanning:
#   1. URL-encoded text (e.g., %40doane.edu -> @doane.edu) is decoded first.
#   2. Base64-encoded text is decoded if it looks like valid base64.
# Useful for scanning webhook payloads, JWT claims, or encoded form fields.
PII_DECODE_ENCODED=false

# ---------------------------------------------------------------------------
# Orkes Conductor Integration (optional - only needed for standalone worker)
# ---------------------------------------------------------------------------

# CONDUCTOR_SERVER_URL=http://localhost:8080/api
# CONDUCTOR_AUTH_KEY=
# CONDUCTOR_AUTH_SECRET=
